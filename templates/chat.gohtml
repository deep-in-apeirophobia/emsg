{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>#{{ .RoomID }} - EMSG.EXE</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#aaaaaa">
		<link rel="stylesheet" href="/static/terminal-dos.css">
	</head>
	<body class="chat" data-conn="down" data-enc="off">
		<header class="menubar">
			<span class="sys" aria-hidden="true">&#8801;</span>
			<nav class="menu" aria-label="Menu">
				<span class="mi opt" aria-disabled="true"><span class="hk">F</span>ile</span>
				<span class="mi opt" aria-disabled="true"><span class="hk">R</span>oom</span>
				<button id="enc-btn" class="mi" type="button" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Set encryption key (F2)"><span class="hk">K</span>ey</button>
				<span class="mi opt" aria-disabled="true"><span class="hk">H</span>elp</span>
			</nav>
			<span class="spacer"></span>
			<span class="right">
				<span class="conn" role="status" aria-live="polite">
					<span id="conn-ok">CONNECT 14400</span>
					<span id="conn-stat"><span class="dialing">DIALING...</span><span class="nocarrier">NO CARRIER</span></span>
				</span>
				<span class="clock" id="clock" aria-hidden="true">--:--</span>
			</span>
		</header>

		<div class="desk">
			<section class="win chat-win" aria-labelledby="win-title">
				<div class="win-title">
					<span class="close" aria-hidden="true">[<b>&#9632;</b>]</span>
					<h1 class="title" id="win-title">#{{ .RoomID }}</h1>
					<span class="zoom" aria-hidden="true">[<b>&#8597;</b>]</span>
				</div>

				<main id="messages" aria-live="polite" aria-label="Messages in #{{ .RoomID }}">
					<section class="bulletin" aria-label="Welcome">
						<span class="blabel" aria-hidden="true">SysOp <b>bulletin</b></span>
<pre class="ansi" aria-hidden="true"><span class="r0">▄█████ ██▄  ▄██ ▄█████ ▄█████</span>
<span class="r1">██▄▄   ██▀██▀██ ██▄▄▄  ██ ▄▄▄</span>
<span class="r2">██▀▀   ██    ██  ▀▀▀██ ██ ▀██</span>
<span class="r3">▀█████ ██    ██ █████▀ ▀█████</span></pre>
						<div class="bl-text">
							<p><span class="star">***</span> Welcome to <span class="hi">#{{ .RoomID }}</span>, <span class="you" data-uname>{{ .Username }}</span>!</p>
							<p><span class="star">***</span> Messages are relayed live to everyone on this node. Nothing is stored.</p>
							<p><span class="star">***</span> Press <kbd>F2</kbd> to set a shared key and encrypt what you send. <kbd>F1</kbd> for help.</p>
						</div>
					</section>
				</main>

				<div class="sep">
					<span class="lbl" aria-hidden="true">Message</span>
					<span class="hint" aria-hidden="true">Enter=Send &middot; Ctrl+Enter=NewLine</span>
					<span class="spacer"></span>
					<span class="enc-state-wrap">Enc: <span class="enc-state" id="enc-state">OFF</span></span>
				</div>

				<form id="msgform" autocomplete="off">
					<label for="msgbox" class="ps1"><span class="sr-only">Message </span><span aria-hidden="true"><span class="drive">C:\</span>&gt;</span></label>
					<div class="input-wrap">
						<textarea id="msgbox" rows="1" placeholder=" Type a message..." spellcheck="false" aria-label="Message"></textarea>
						<span class="cursor" aria-hidden="true"></span>
					</div>
					<button type="submit" class="tvbtn default" title="Send (Enter)"><span class="hk">S</span>end</button>
				</form>
			</section>
		</div>

		<footer class="fkeys">
			<button type="button" class="fk" id="help-btn" title="Show help (F1)"><kbd>F1</kbd><span class="lb">Help</span></button>
			<button type="button" class="fk" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Set encryption key (F2)"><kbd>F2</kbd><span class="lb">Key</span></button>
			<span class="fk opt" aria-hidden="true"><kbd>^Enter</kbd><span class="lb">NewLine</span></span>
			<span class="fk" aria-hidden="true"><kbd>Enter</kbd><span class="lb">Send</span></span>
			<span class="spacer"></span>
			<span class="who">User: <b data-uname>{{ .Username }}</b></span>
		</footer>

		<dialog id="encKeyDia" aria-labelledby="enc-title">
			<form class="tv-dlg" method="dialog">
				<div class="dlg-title">
					<span class="close" aria-hidden="true">[<b>&#9632;</b>]</span>
					<h2 id="enc-title">Encryption Key</h2>
				</div>
				<p class="dlg-desc">Everyone in the room must use the same key. Leave blank to send plain text.</p>
				<p id="message" role="alert"></p>
				<div class="dlg-field">
					<label for="enckey"><span class="hk">K</span>ey:</label>
					<div class="input-wrap">
						<input id="enckey" type="password" autocomplete="off" spellcheck="false" placeholder=" shared secret">
						<span class="cursor" aria-hidden="true"></span>
					</div>
				</div>
				<p class="dlg-help">Keys never leave this machine.</p>
				<div class="dlg-actions">
					<button class="tvbtn default" id="confirmBtn" value="confirm" formmethod="dialog">[ OK ]</button>
					<button class="tvbtn" value="cancel" formmethod="dialog" formnovalidate>[Cancel]</button>
				</div>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
