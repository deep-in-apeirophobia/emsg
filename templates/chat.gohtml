{{ define "chat" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
	<meta name="color-scheme" content="light dark">
	<title>{{ .RoomID }} · Message Kaskade</title>
	<link rel="stylesheet" href="/static/bubbles.css">
</head>
<body class="wallpaper">
	<div class="chat">
		<header class="appbar">
			<div class="room-avatar">
				<span class="avatar" id="room-avatar" aria-hidden="true">#</span>
				<span class="conn-dot" id="conn-dot" data-state="offline" role="img" aria-label="Connecting"></span>
			</div>
			<div class="titles">
				<h1 class="room-title">{{ .RoomID }}</h1>
				<p class="subtitle"><span class="status" id="conn-text" data-state="offline">connecting…</span> · you are <b id="me-name">{{ .Username }}</b></p>
			</div>
			<button type="button" class="lock-pill" id="lock-pill" data-encrypted="false" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Set encryption key">
				<svg class="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="11" width="15" height="10" rx="2.5"/><path d="M8 11V7.5a4 4 0 0 1 7.6-1.7"/></svg>
				<svg class="icon-closed" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="11" width="15" height="10" rx="2.5"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>
				<span class="label" id="lock-label">Not encrypted</span>
			</button>
		</header>

		<div class="stage">
			<div id="conn-stat" class="conn-banner" role="status">
				<span class="spinner" aria-hidden="true"></span>
				Connecting...
			</div>

			<main id="messages" class="messages" aria-live="polite" aria-label="Messages">
				<div class="thread" id="thread">
					<div class="welcome">
						<div class="w-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.4c-.5.4-1.3 0-1.3-.6V17A2.5 2.5 0 0 1 4 14.5z"/><path d="M8.5 9h7M8.5 12.5h4.5"/></svg>
						</div>
						<h2>Welcome to {{ .RoomID }}</h2>
						<p>Messages go to everyone in this room right now. Nothing is stored — only people who are here will see them.</p>
						<ul>
							<li>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="11" width="15" height="10" rx="2.5"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>
								<span>Tap the lock to set a shared key and encrypt your messages.</span>
							</li>
							<li>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 10 4 15l5 5"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg>
								<span><kbd>Enter</kbd> sends, <kbd>Ctrl</kbd>+<kbd>Enter</kbd> adds a new line.</span>
							</li>
						</ul>
					</div>
				</div>
			</main>
		</div>

		<footer class="composer">
			<form id="msgform" autocomplete="off">
				<div class="field-pill">
					<label for="msgbox" class="sr-only">Message</label>
					<textarea id="msgbox" rows="1" placeholder="Message" enterkeyhint="send"></textarea>
				</div>
				<button type="submit" class="send-btn" id="send-btn" aria-label="Send message" disabled>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19.5V5"/><path d="m5.5 11.5 6.5-6.5 6.5 6.5"/></svg>
				</button>
			</form>
		</footer>
	</div>

	<dialog id="encKeyDia" class="dialog" aria-labelledby="enc-title">
		<form method="dialog" id="encForm">
			<div class="d-head">
				<div class="d-icon" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 8.7-8.7M16.5 6.5l2.5 2.5M14 9l2 2"/></svg>
				</div>
				<div>
					<h3 id="enc-title">Encryption key</h3>
					<p class="d-desc">Everyone in the room needs the same key. Leave it empty to send unencrypted.</p>
				</div>
			</div>
			<p class="d-error" id="enc-message" role="alert"></p>
			<div class="field">
				<label for="enckey">Shared key</label>
				<div class="input-wrap">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="11" width="15" height="10" rx="2.5"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>
					<input id="enckey" type="password" class="input" placeholder="Enter encryption key" autocomplete="off" spellcheck="false">
				</div>
			</div>
			<div class="d-actions">
				<button type="button" class="btn btn-ghost" id="cancelBtn" value="cancel">Cancel</button>
				<button type="submit" class="btn btn-primary" id="confirmBtn" value="confirm">Save key</button>
			</div>
		</form>
	</dialog>

	<script>
		window.chatdata = {
			room_id: {{ .RoomID }},
			user_id: {{ .UserID }},
			username: {{ .Username }},
		}
	</script>
	<script src="/static/wasm_exec.js"></script>
	<script src="/static/index.js"></script>
</body>
</html>
{{ end }}
