{{ define "home_logged_in" }}
	<div class="fld">
		<span class="lbl">USERID</span><span class="arrow" aria-hidden="true">===&gt;</span>
		<span class="pfield" data-uname>{{ .Username }}</span>
	</div>
	<p class="smsg ok"><span class="code">EMS100I</span> SESSION <span class="pv">{{ slice .UserID 0 7 }}</span> ACTIVE FOR USERID <span class="pv up" data-uname>{{ .Username }}</span>. ENTER A ROOM TO RECONNECT.</p>
{{ end }}
{{ define "home_login" }}
	<div class="fld">
		<label class="lbl" for="username">USERID</label><span class="arrow" aria-hidden="true">===&gt;</span>
		<input id="username" name="username" class="ufld" maxlength="32" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus>
	</div>
{{ end }}
{{ define "home" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>EMSG - LOGON</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<link rel="stylesheet" href="/static/terminal-mainframe.css">
	</head>
	<body class="t3270 logon">
		<div class="screen">
			<header class="titleline">
				<span class="tl-id">EMSG01</span>
				<span class="rule" aria-hidden="true"></span>
				<h1 class="tl-title">VTAM LOGON</h1>
				<span class="rule" aria-hidden="true"></span>
				<span class="tl-right" id="tod">--/--/-- --.--.--</span>
			</header>

			<main class="logon-body">
				<div class="banner" role="img" aria-label="EMSG">
<pre class="bl b-e" aria-hidden="true">EEEEEEEEE
EEEEEEEEE
EEE
EEEEEEE
EEE
EEEEEEEEE
EEEEEEEEE</pre>
<pre class="bl b-m" aria-hidden="true">MMM     MMM
MMMM   MMMM
MMMMM MMMMM
MMM MMM MMM
MMM  M  MMM
MMM     MMM
MMM     MMM</pre>
<pre class="bl b-s" aria-hidden="true"> SSSSSSS
SSSSSSSSS
SSS
 SSSSSSS
      SSS
SSSSSSSSS
 SSSSSSS</pre>
<pre class="bl b-g" aria-hidden="true"> GGGGGGGG
GGGGGGGGGG
GGG
GGG  GGGGG
GGG    GGG
GGGGGGGGGG
 GGGGGGGG</pre>
				</div>
				<p class="subtitle">ELECTRONIC MESSAGE SYSTEM &middot; KASKADE RELAY</p>

				<dl class="sysinfo">
					<div><dt>APPLID</dt><dd>EMSG</dd></div>
					<div><dt>NETWORK</dt><dd>LOCAL LAN</dd></div>
					<div><dt>TERMINAL</dt><dd>3278-5</dd></div>
					<div><dt>CIPHER</dt><dd>KASENC AES</dd></div>
				</dl>

				<form method="post" action="/" class="logon-form">
					<p class="cmd"><span class="lbl">LOGON</span> <span class="pv">APPLID(EMSG)</span> <span class="lbl">DATA(</span><span class="pv">ROOM</span><span class="lbl">)</span></p>
					<p class="instr">{{if .IsLoggedIn}}==&gt; ENTER THE ROOM TO JOIN AND PRESS ENTER.{{else}}==&gt; ENTER YOUR USERID AND A ROOM, THEN PRESS ENTER.{{end}}</p>

					{{if .IsLoggedIn}}
						{{ template "home_logged_in" . }}
					{{else}}
						{{ template "home_login" }}
					{{end}}
					<div class="fld">
						<label class="lbl" for="roomid">ROOM</label><span class="arrow" aria-hidden="true">===&gt;</span>
						<input id="roomid" name="roomid" class="ufld" value="{{ .RoomID }}" maxlength="64" autocomplete="off" autocapitalize="off" spellcheck="false" {{if .IsLoggedIn}}autofocus{{end}}>
					</div>

					{{ if .Error }}
						<p class="smsg err" role="alert"><span class="code">EMS403E</span> LOGON REJECTED - {{ .ErrorMessage }}</p>
					{{ end }}

					<div class="pfkeys">
						<button type="submit" class="pf pf-enter">ENTER=LOGON</button>
						<button type="reset" class="pf">PF12=CLEAR</button>
					</div>
				</form>
			</main>
		</div>

		<footer class="oia" aria-label="Operator information area">
			<span class="oia-rdy" aria-hidden="true"><b>4</b><b>A</b></span>
			<span class="oia-lu" aria-hidden="true">&#9830;</span>
			<span class="oia-app">EMSG</span>
			<span class="oia-stat">{{if .Error}}<span class="x">X</span> PROG 403{{end}}</span>
			<span class="oia-fill"></span>
			<span class="oia-pos" aria-hidden="true">001/001</span>
		</footer>

		<script>
			(function () {
				// Stored usernames are HTML-escaped server-side; decode once for display.
				var t = document.createElement("textarea");
				document.querySelectorAll("[data-uname]").forEach(function (n) {
					t.innerHTML = n.textContent;
					n.textContent = t.value;
				});
				var tod = document.getElementById("tod");
				function p(n) { return n < 10 ? "0" + n : "" + n; }
				function tick() {
					var d = new Date();
					tod.textContent = p(d.getFullYear() % 100) + "/" + p(d.getMonth() + 1) + "/" + p(d.getDate()) + " " + p(d.getHours()) + "." + p(d.getMinutes()) + "." + p(d.getSeconds());
				}
				tick();
				setInterval(tick, 1000);
				// OIA cursor position tracks the focused field
				var pos = document.querySelector(".oia-pos");
				var fields = Array.prototype.slice.call(document.querySelectorAll(".ufld"));
				function where() {
					var a = document.activeElement, i = fields.indexOf(a);
					if (i < 0) return;
					var c = (a.selectionStart || 0) + 1;
					pos.textContent = p(i + 20).padStart(3, "0") + "/" + String(c + 13).padStart(3, "0");
				}
				["focusin", "keyup", "click", "input"].forEach(function (ev) { document.addEventListener(ev, where); });
				where();
			})();
		</script>
	</body>
	</html>
{{ end }}
