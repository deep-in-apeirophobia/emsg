{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>EMSG - ROOM {{ .RoomID }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<link rel="stylesheet" href="/static/terminal-mainframe.css">
	</head>
	<body class="t3270 chat" data-conn="down" data-enc="off">
		<div class="screen">
			<header class="panel-head">
				<div class="titleline">
					<span class="tl-id">EMSG</span>
					<span class="rule" aria-hidden="true"></span>
					<h1 class="tl-title">ROOM <span class="room">{{ .RoomID }}</span></h1>
					<span class="rule" aria-hidden="true"></span>
					<span class="tl-right">
						<span id="rowinfo">ROW 0 TO 0 OF 0</span>
						<span id="smsg" role="status" aria-live="polite"></span>
					</span>
				</div>

				<form class="cmdline" id="cmdform" autocomplete="off">
					<label class="lbl" for="cmd">COMMAND ===&gt;</label>
					<input id="cmd" class="ufld" name="cmd" spellcheck="false" autocapitalize="characters" aria-describedby="cmdhelp">
					<span class="scroll" aria-hidden="true"><span class="lbl">SCROLL ===&gt;</span> <span class="pv">CSR</span></span>
					<span id="cmdhelp" class="sr-only">Commands: HELP, KEY, TOP, BOTTOM, UP, DOWN, CLEAR, END.</span>
				</form>

				<dl class="info">
					<div><dt>USERID</dt><dd class="pv up" data-uname>{{ .Username }}</dd></div>
					<div><dt>ROOM</dt><dd class="pv up">{{ .RoomID }}</dd></div>
					<div><dt>ENCRYPT</dt><dd class="pv" id="enc-state">OFF</dd></div>
					<div class="info-time"><dt>TIME</dt><dd class="pv" id="clock">--.--</dd></div>
				</dl>
			</header>

			<div class="tablehead" aria-hidden="true">
				<span>TIME</span><span>USERID</span><span>MESSAGE</span>
			</div>

			<main id="messages" tabindex="-1" aria-label="Messages in room {{ .RoomID }}">
				<div class="marker tod" aria-hidden="true"><span class="stars"></span><span class="mk">TOP OF DATA</span><span class="stars"></span></div>
				<div class="line sys note">
					<span class="ts">--.--<span class="sec">.--</span></span>
					<span class="text"><span class="code">EMS000I</span> WELCOME TO EMSG, <span class="who" data-uname>{{ .Username }}</span>. ROOM <span class="who">{{ .RoomID }}</span> IS NOW ACTIVE.</span>
				</div>
				<div class="line sys note">
					<span class="ts">--.--<span class="sec">.--</span></span>
					<span class="text"><span class="code">EMS003I</span> MESSAGES ARE RELAYED LIVE TO USERS IN THIS ROOM. NOTHING IS STORED.</span>
				</div>
				<div class="line sys note">
					<span class="ts">--.--<span class="sec">.--</span></span>
					<span class="text"><span class="code">EMS004I</span> PRESS PF5 TO SET A SHARED KEY FOR END-TO-END ENCRYPTION. PF1 FOR HELP.</span>
				</div>
				<div class="marker bod" id="bod" aria-hidden="true"><span class="stars"></span><span class="mk">BOTTOM OF DATA</span><span class="stars"></span></div>
			</main>

			<footer class="panel-foot">
				<form id="msgform" autocomplete="off">
					<label for="msgbox" class="lbl">MESSAGE ===&gt;</label>
					<textarea id="msgbox" class="ufld" rows="1" spellcheck="false" aria-label="Message" aria-describedby="sendhelp"></textarea>
					<span id="sendhelp" class="sr-only">Enter sends. Control or Command plus Enter inserts a new line.</span>
				</form>
				<nav class="pfkeys" aria-label="Function keys">
					<button type="button" class="pf" data-pf="help" title="Show help">PF1=HELP</button>
					<button type="button" class="pf" data-pf="end" title="Leave room">PF3=END</button>
					<button type="button" class="pf" id="enc-btn" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Set encryption key">PF5=KEY</button>
					<button type="button" class="pf pf-scroll" data-pf="up" title="Scroll up">PF7=UP</button>
					<button type="button" class="pf pf-scroll" data-pf="down" title="Scroll down">PF8=DOWN</button>
					<button type="submit" class="pf pf-enter" form="msgform" title="Send (Enter)">ENTER=SEND</button>
				</nav>
			</footer>
		</div>

		<footer class="oia" aria-label="Operator information area">
			<span class="oia-rdy" aria-hidden="true"><b>4</b><b>A</b></span>
			<span class="oia-lu" aria-hidden="true">&#9830;</span>
			<span class="oia-app up">{{ .RoomID }}</span>
			<span id="conn-stat" role="status" aria-live="polite"><span class="x" aria-hidden="true">X</span> <span class="xt" aria-hidden="true">CLOCK</span><span class="sr-only" id="conn-sr">Connecting...</span></span>
			<span class="oia-fill"></span>
			<span class="oia-enc" aria-hidden="true">SECURE</span>
			<span class="oia-pos" id="oia-pos" aria-hidden="true">001/014</span>
		</footer>

		<dialog id="encKeyDia" aria-labelledby="enc-title" aria-describedby="enc-desc">
			<form class="popup" method="dialog">
				<h2 class="pop-title" id="enc-title">ENCRYPTION KEY</h2>
				<div class="pop-head">
					<span class="lbl">EMSK01</span>
					<span class="pv">SET SESSION KEY</span>
				</div>
				<p class="pop-desc" id="enc-desc">EVERY USER IN THE ROOM MUST ENTER THE SAME KEY. LEAVE BLANK TO SEND IN CLEAR TEXT.</p>
				<p id="message" role="alert"></p>
				<div class="fld">
					<label for="enckey" class="lbl">ENTER KEY</label><span class="arrow" aria-hidden="true">===&gt;</span>
					<input id="enckey" class="ufld" type="password" autocomplete="off" spellcheck="false">
				</div>
				<p class="pop-help">THE KEY IS HELD IN THIS TERMINAL ONLY AND NEVER TRANSMITTED.</p>
				<div class="pfkeys">
					<button class="pf pf-enter" id="confirmBtn" value="confirm" formmethod="dialog">ENTER=CONFIRM</button>
					<button class="pf" value="cancel" formmethod="dialog" formnovalidate>PF3=CANCEL</button>
				</div>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
