{{ define "home_logged_in" }}
	<div class="session">
		<p class="dim">Last login: session <span class="hi" data-uname>{{ .Username }}</span> <span class="faint">({{ slice .UserID 0 7 }}…)</span></p>
		<p class="dim">Welcome back, operator. Pick a room to join.</p>
	</div>
{{ end }}
{{ define "home_login" }}
	<div class="field">
		<label for="username">emsg login:</label>
		<input id="username" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="your handle" required autofocus>
	</div>
{{ end }}
{{ define "home" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>emsg // login</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="dark">
		<link rel="stylesheet" href="/static/terminal.css">
	</head>
	<body class="crt">
		<main class="boot">
			<div class="boot-screen">
<pre class="banner" aria-label="emsg">███████╗███╗   ███╗███████╗ ██████╗
██╔════╝████╗ ████║██╔════╝██╔════╝
█████╗  ██╔████╔██║███████╗██║  ███╗
██╔══╝  ██║╚██╔╝██║╚════██║██║   ██║
███████╗██║ ╚═╝ ██║███████║╚██████╔╝
╚══════╝╚═╝     ╚═╝╚══════╝ ╚═════╝</pre>
				<p class="banner-sub">emergency LAN messenger &middot; kaskade relay</p>

				<ul class="boot-log" aria-hidden="true">
					<li>[ <span class="ok">&nbsp;OK&nbsp;</span> ] Started emsg relay daemon.</li>
					<li>[ <span class="ok">&nbsp;OK&nbsp;</span> ] Reached target Local Area Network.</li>
					<li>[ <span class="ok">&nbsp;OK&nbsp;</span> ] Loaded kasenc cipher module.</li>
					<li>[ <span class="ok">&nbsp;OK&nbsp;</span> ] Listening for peers on websocket.</li>
					<li>[ <span class="wait">WAIT</span> ] Awaiting operator login<span class="cursor"></span></li>
				</ul>

				<form method="post" action="/" class="login">
					<p class="login-issue">emsg 1.0 (tty1)</p>
					{{if .IsLoggedIn}}
						{{ template "home_logged_in" . }}
					{{else}}
						{{ template "home_login" }}
					{{end}}
					<div class="field">
						<label for="roomid">{{if .IsLoggedIn}}<span data-uname>{{ .Username }}</span>@emsg:~$ join #{{else}}room: #{{end}}</label>
						<input id="roomid" name="roomid" value="{{ .RoomID }}" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="lobby" {{if .IsLoggedIn}}autofocus{{end}}>
					</div>

					{{ if .Error }}
						<p class="login-error err" role="alert">Login incorrect: {{ .ErrorMessage }}</p>
					{{ end }}

					<div class="login-actions">
						<button type="submit" class="btn-enter">[ ENTER ]</button>
						<span class="hint">press <kbd>&#9166; Enter</kbd> to connect</span>
					</div>
				</form>
			</div>
		</main>
		<script>
			// Stored usernames are HTML-escaped server-side; decode once for display.
			(function () {
				var t = document.createElement("textarea");
				document.querySelectorAll("[data-uname]").forEach(function (n) {
					t.innerHTML = n.textContent;
					n.textContent = t.value;
				});
			})();
		</script>
	</body>
	</html>
{{ end }}
