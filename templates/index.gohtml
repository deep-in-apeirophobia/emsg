{{ define "home_logged_in" }}
	<div class="byline-card">
		<span class="label">Signed in as</span>
		<p class="byline-name"><span class="name" data-entities>{{ .Username }}</span></p>
		<p class="byline-note">Choose a room below to carry on the correspondence.</p>
	</div>
{{ end }}
{{ define "home_login" }}
	<div class="field">
		<label for="username" class="label">Your name</label>
		<input id="username" name="username" autocomplete="nickname" autocapitalize="off" spellcheck="false" placeholder="e.g. Ada">
	</div>
{{ end }}
{{ define "home" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="color-scheme" content="light dark">
	<title>The emsg Dispatch</title>
	<link rel="stylesheet" href="/static/editorial.css">
</head>
<body class="page-home">
	<main class="cover">
		<div class="cover-folio">
			<span>Vol. I &middot; No. 1</span>
			<span class="folio-mid">Local Network Edition</span>
			<span id="folio-date">Emergency Messenger</span>
		</div>
		<hr class="rule-double">

		<header class="cover-head">
			<p class="cover-kicker">Correspondence, when the lines are down</p>
			<h1 class="cover-title"><span class="the">The</span> emsg <em>Dispatch</em></h1>
			<p class="cover-deck">A small chat room that runs on your own network. Pick a name, name a room, and write&thinsp;&mdash;&thinsp;with an optional shared cipher for private letters.</p>
		</header>

		<hr class="rule">

		<form method="post" class="signin{{ if .IsLoggedIn }} is-logged-in{{ end }}">
			<h2 class="section-label"><span>{{ if .IsLoggedIn }}Return to the rooms{{ else }}Sign in{{ end }}</span></h2>

			{{ if .Error }}
			<p class="erratum" role="alert"><span class="label">Erratum</span> {{ .ErrorMessage }}</p>
			{{ end }}

			<div class="signin-fields">
				{{ if .IsLoggedIn }}
					{{ template "home_logged_in" . }}
				{{ else }}
					{{ template "home_login" }}
				{{ end }}
				<div class="field">
					<label for="roomid" class="label">Room</label>
					<input id="roomid" name="roomid" value="{{ .RoomID }}" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="e.g. lobby">
				</div>
			</div>

			<div class="signin-foot">
				<p class="fineprint">Everyone who enters the same room reads the same page.</p>
				<button type="submit" class="btn btn-ink">Enter the room <span aria-hidden="true">&rarr;</span></button>
			</div>
		</form>

		<footer class="cover-foot">
			<span aria-hidden="true">❦</span>
		</footer>
	</main>
	<script>
		(function () {
			try {
				var el = document.getElementById("folio-date");
				var narrow = window.matchMedia && window.matchMedia("(max-width: 640px)").matches;
				el.textContent = new Date().toLocaleDateString(undefined, narrow
					? { day: "numeric", month: "short", year: "numeric" }
					: { weekday: "long", day: "numeric", month: "long", year: "numeric" });
			} catch (e) {}
			document.querySelectorAll("[data-entities]").forEach(function (el) {
				try {
					el.textContent = new DOMParser().parseFromString(el.textContent, "text/html").documentElement.textContent;
				} catch (e) {}
			});
		})();
	</script>
</body>
</html>
{{ end }}
