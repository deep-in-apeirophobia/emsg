{{ define "home_logged_in" }}
	<div class="fz-session">
		<span class="ok-dot" aria-hidden="true">●</span>
		<span>attached as <b class="hl-name" data-uname>{{ .Username }}</b> <span class="dim">({{ slice .UserID 0 7 }}…)</span></span>
	</div>
{{ end }}
{{ define "home_login" }}
	<div class="fz-field">
		<label for="username" class="fz-prompt">name <span aria-hidden="true">❯</span></label>
		<input id="username" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="your nick" required autofocus>
	</div>
{{ end }}
{{ define "home" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>new-session — emsg</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#11111b">
		<link rel="stylesheet" href="/static/terminal-tmux.css">
	</head>
	<body class="tmux home">
		<div class="workspace">
			<main class="pane pane-home" aria-label="New session">
				<header class="pane-head">
					<span class="ph-idx">0</span>
					<span class="ph-title">zsh</span>
					<span class="ph-fill" aria-hidden="true"></span>
					<span class="ph-who">~</span>
				</header>

				<div class="shell">
					<p class="sh-line" aria-hidden="true"><span class="sh-p">~</span> <span class="sh-arrow">❯</span> emsg new-session</p>
<pre class="big-logo" aria-label="emsg">┌─┐┌┬┐┌─┐┌─┐
├┤ │││└─┐│ ┬
└─┘┴ ┴└─┘└─┘</pre>
					<p class="tagline">emergency LAN messenger <span class="dim">·</span> kaskade relay<span class="wide"> <span class="dim">·</span> end-to-end optional</span></p>

					<form method="post" action="/" class="picker" id="picker">
						<div class="picker-main">
							<h1 class="float-title"><span>new-session</span></h1>
							{{if .IsLoggedIn}}
								{{ template "home_logged_in" . }}
							{{else}}
								{{ template "home_login" }}
							{{end}}
							<div class="fz-field">
								<label for="roomid" class="fz-prompt">room <span aria-hidden="true">❯</span></label>
								<span class="fz-hash" aria-hidden="true">#</span>
								<input id="roomid" name="roomid" value="{{ .RoomID }}" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="lobby" {{if .IsLoggedIn}}autofocus{{end}}>
							</div>
							<div class="fz-sep" aria-hidden="true"><span class="fz-count" id="fz-count">{{if .IsLoggedIn}}1{{else}}0{{end}}/2</span></div>

							{{ if .Error }}
								<p class="fz-error" role="alert"><b>✗ error:</b> {{ .ErrorMessage }}</p>
							{{ end }}

							<button type="submit" class="fz-item">
								<span class="fz-cursor" aria-hidden="true">▌</span>
								<span class="fz-act">attach</span>
								<span class="fz-target" id="fz-target" aria-hidden="true"></span>
								<kbd class="fz-key">⏎</kbd>
							</button>
							<p class="fz-help dim"><kbd>Tab</kbd> next field · <kbd>Enter</kbd> attach · empty room = stay here</p>
						</div>

						<aside class="picker-preview" aria-label="Preview">
							<h2 class="float-title"><span>preview</span></h2>
							<p class="pv-cmd"><span class="sh-arrow">❯</span> tmux new -s emsg -n <span id="pv-win">#…</span></p>
							<dl class="pv-list">
								<dt>nick</dt><dd id="pv-nick"{{if .IsLoggedIn}} data-uname{{end}}>{{if .IsLoggedIn}}{{ .Username }}{{else}}—{{end}}</dd>
								<dt>buffer</dt><dd id="pv-room">—</dd>
								<dt>socket</dt><dd id="pv-ws">—</dd>
								<dt>crypto</dt><dd>off · set a key in-room</dd>
								<dt>history</dt><dd>none · live only</dd>
							</dl>
						</aside>
					</form>
				</div>
			</main>
		</div>

		<nav class="statusbar" aria-label="Status">
			<div class="sb-left">
				<span class="pl pl-r seg-session"><span class="glyph" aria-hidden="true">❐</span> emsg</span>
				<span class="pl pl-r seg-win active" aria-current="page">0:new-session*</span>
			</div>
			<div class="sb-right">
				<span class="pl pl-l seg-enc">{{if .IsLoggedIn}}<span data-uname>{{ .Username }}</span>{{else}}detached{{end}}</span>
				<span class="pl pl-l seg-clock"><span class="wide date" id="date"></span> <b id="clock">--:--</b></span>
			</div>
		</nav>

		<script>
			(function () {
				// Stored usernames are HTML-escaped server-side; decode once for display.
				var t = document.createElement("textarea");
				document.querySelectorAll("[data-uname]").forEach(function (n) {
					t.innerHTML = n.textContent;
					n.textContent = t.value;
				});

				// fzf-style live preview
				var nick = document.getElementById("username");
				var room = document.getElementById("roomid");
				var loggedNick = document.getElementById("pv-nick").textContent;
				function upd() {
					var n = nick ? nick.value.trim() : loggedNick;
					var r = room.value.trim();
					document.getElementById("pv-nick").textContent = n || "—";
					document.getElementById("pv-room").textContent = r ? "1:#" + r : "—";
					document.getElementById("pv-win").textContent = "'#" + (r || "…") + "'";
					document.getElementById("pv-ws").textContent = r ? "/ws/" + encodeURIComponent(r) : "—";
					document.getElementById("fz-target").textContent = r
						? (n || "<nick>") + " → #" + r
						: (n || "<nick>") + " → (no room)";
					document.getElementById("fz-count").textContent =
						((n ? 1 : 0) + (r ? 1 : 0)) + "/2";
				}
				if (nick) nick.addEventListener("input", upd);
				room.addEventListener("input", upd);
				upd();

				// status-line clock
				var days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
				function p(x) { return x < 10 ? "0" + x : "" + x; }
				function tick() {
					var d = new Date();
					document.getElementById("clock").textContent = p(d.getHours()) + ":" + p(d.getMinutes());
					document.getElementById("date").textContent = days[d.getDay()] + " " + p(d.getDate()) + "/" + p(d.getMonth() + 1);
					setTimeout(tick, 60000 - (Date.now() % 60000) + 50);
				}
				tick();
			})();
		</script>
	</body>
	</html>
{{ end }}
