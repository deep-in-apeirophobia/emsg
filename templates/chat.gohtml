{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>1:#{{ .RoomID }} — emsg</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#11111b">
		<link rel="stylesheet" href="/static/terminal-tmux.css">
	</head>
	<body class="tmux chat" data-conn="down" data-enc="off" data-mode="normal">
		<div class="workspace">
			<!-- pane 0: weechat-style buffer + neovim composer -->
			<section class="pane pane-chat" aria-label="Chat #{{ .RoomID }}">
				<header class="pane-head">
					<span class="ph-idx">0</span>
					<span class="ph-title">#{{ .RoomID }}</span>
					<span class="ph-topic">live relay · nothing is stored</span>
					<span class="ph-fill" aria-hidden="true"></span>
					<span class="ph-who"><span data-uname>{{ .Username }}</span>@emsg</span>
				</header>

				<main id="messages" class="buffer" aria-live="polite" aria-label="Messages in #{{ .RoomID }}">
					<div class="motd" aria-label="Welcome">
<pre class="logo" aria-hidden="true">┌─┐┌┬┐┌─┐┌─┐
├┤ │││└─┐│ ┬
└─┘┴ ┴└─┘└─┘</pre>
						<div class="motd-side">
							<p class="motd-name">emsg <span class="dim">·</span> <span class="ver">kaskade relay</span></p>
							<p class="dim">buffer <span class="hl">1:#{{ .RoomID }}</span> opened for <span class="self-name" data-uname>{{ .Username }}</span></p>
						</div>
					</div>
					<div class="line sys info"><span class="ts">--:--</span><span class="nick"><span class="pfx">--</span></span><span class="text">Welcome to <span class="hl">#{{ .RoomID }}</span>. Messages are relayed live to everyone here; nothing is stored.</span></div>
					<div class="line sys info"><span class="ts">--:--</span><span class="nick"><span class="pfx">--</span></span><span class="text">Set a shared key with <kbd>e</kbd> (or the <span class="hl">enc</span> segment below) to end-to-end encrypt. Press <kbd>i</kbd> to start typing.</span></div>
				</main>

				<footer class="composer">
					<form id="msgform" autocomplete="off">
						<label for="msgbox" class="gutter" aria-hidden="true"><span class="gnum">1</span><span class="gbar"></span></label>
						<textarea id="msgbox" rows="1" placeholder="message #{{ .RoomID }}" spellcheck="false" aria-label="Message" aria-describedby="keyhint"></textarea>
						<button type="submit" class="send" title="Send (Enter)"><span class="send-cmd">:w</span><span class="send-ret" aria-hidden="true">⏎</span><span class="sr-only"> send</span></button>
					</form>
					<div class="nvim-status" aria-hidden="true">
						<span class="ns-mode" id="mode">NORMAL</span>
						<span class="ns-file">msg://#{{ .RoomID }}</span>
						<span class="ns-mod" id="modflag"></span>
						<span class="ns-fill"></span>
						<span class="ns-enc">enc:<b id="ns-enc">off</b></span>
						<span class="ns-ft">utf-8</span>
						<span class="ns-pos" id="caret">1:1</span>
					</div>
					<div class="cmdline">
						<span class="cl-mode" id="cmdmode" aria-hidden="true"></span>
						<span class="cl-err" aria-hidden="true">E: relay unreachable — retrying…</span>
						<span class="cl-hint" id="keyhint"><kbd>Enter</kbd> send · <kbd>Ctrl</kbd>+<kbd>Enter</kbd> newline · <kbd>Esc</kbd> normal</span>
					</div>
				</footer>
			</section>

			<!-- pane 1: nicklist -->
			<aside class="pane pane-users" id="users-pane" aria-label="Users in this session">
				<header class="pane-head">
					<span class="ph-idx">1</span>
					<span class="ph-title">users</span>
					<span class="ph-fill" aria-hidden="true"></span>
					<span class="ph-count" id="users-count">1</span>
				</header>
				<ul class="nicklist" id="nicklist"></ul>
				<p class="nick-foot">seen this session<br><span class="dim">● here &nbsp; ○ left</span></p>
			</aside>
		</div>

		<!-- tmux status line -->
		<nav class="statusbar" aria-label="Status">
			<div class="sb-left">
				<span class="pl pl-r seg-session" title="tmux session"><span class="glyph" aria-hidden="true">❐</span> emsg</span>
				<a class="pl pl-r seg-win" href="/" title="Leave room (back to new-session)">0:home</a>
				<span class="pl pl-r seg-win active" aria-current="page">1:#{{ .RoomID }}*</span>
				<button type="button" class="pl pl-r seg-win seg-users" id="users-toggle" aria-controls="users-pane" aria-expanded="true" title="Toggle users pane">2:users<span class="uc">(<span id="users-count-sb">1</span>)</span></button>
			</div>
			<div class="sb-right">
				<button id="enc-btn" class="pl pl-l seg-enc" type="button" command="show-modal" commandfor="encKeyDia" title="Set encryption key (e)" aria-haspopup="dialog">
					<svg class="lock" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true"><path class="shackle" d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="2.5" y="7" width="11" height="8" rx="1.5" fill="currentColor"/></svg>
					<span><span class="sr-narrow">enc:</span><b class="enc-state" id="enc-state">off</b></span>
				</button>
				<span class="pl pl-l seg-conn" role="status" aria-live="polite">
					<span id="conn-ok"><span class="dot" aria-hidden="true">●</span><span class="sr-narrow"> online</span></span>
					<span id="conn-stat"><span class="dot" aria-hidden="true">✗</span> <span class="wide">reconnecting…</span><span class="narrow">down</span></span>
				</span>
				<span class="pl pl-l seg-clock"><span class="wide date" id="date"></span> <b id="clock">--:--</b></span>
			</div>
		</nav>

		<dialog id="encKeyDia" class="float" aria-labelledby="enc-title">
			<form method="dialog" class="float-box">
				<h2 class="float-title" id="enc-title"><span>Encryption key</span></h2>
				<div class="float-body">
					<p class="float-desc">Everyone in <span class="hl">#{{ .RoomID }}</span> must use the same key. Leave it empty to send plain text.</p>
					<p id="message" role="alert"></p>
					<div class="fz-field">
						<label for="enckey" class="fz-prompt">key <span aria-hidden="true">❯</span></label>
						<input id="enckey" type="password" autocomplete="off" spellcheck="false" placeholder="shared secret">
					</div>
					<p class="float-help dim">The key stays in this tab. It is never sent to the relay.</p>
					<div class="float-actions">
						<button class="fbtn primary" id="confirmBtn" value="confirm" formmethod="dialog">confirm <kbd>⏎</kbd></button>
						<button class="fbtn" value="cancel" formmethod="dialog" formnovalidate>cancel <kbd>esc</kbd></button>
					</div>
				</div>
				<p class="float-foot" aria-hidden="true"><span>AES · kasenc</span></p>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
