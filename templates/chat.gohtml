{{ define "chat" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
	<meta name="color-scheme" content="light">
	<title>#{{ .RoomID }} · EMSG</title>
	<link rel="stylesheet" href="/static/brutalist.css">
</head>
<body class="page-chat">
	<div class="app" id="app">
		<header class="roombar">
			<a class="roombar__brand" href="/" title="Back to start">EMSG</a>
			<div class="roombar__room">
				<span class="roombar__kicker">Room</span>
				<h1 class="roombar__name" title="{{ .RoomID }}"><span aria-hidden="true">#</span>{{ .RoomID }}</h1>
			</div>
			<div class="roombar__me" id="me-chip" title="You">
				<span class="roombar__me-label">You</span>
				<span class="nametag" id="me-name"></span>
			</div>
			<button type="button" class="btn btn--white keybtn" id="keybtn" command="show-modal" commandfor="encKeyDia" title="Set encryption key" aria-haspopup="dialog">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.8-9.8"/><path d="m16 7 3 3"/><path d="m18.5 4.5 2 2"/></svg>
				<span class="keybtn__state" id="key-state">No key</span>
			</button>
		</header>

		<main class="feed" id="messages" aria-live="polite" aria-label="Messages">
			<section class="welcome card">
				<div class="card__bar card__bar--violet">
					<span class="card__bar-title">Welcome to #{{ .RoomID }}</span>
					<span class="card__bar-dots" aria-hidden="true"><i></i><i></i><i></i></span>
				</div>
				<div class="card__body welcome__body">
					<p class="welcome__lead">You're in. Only messages sent while you're connected show up here.</p>
					<ul class="welcome__tips">
						<li><kbd>Enter</kbd><span>send message</span></li>
						<li><kbd>Ctrl</kbd><b>+</b><kbd>Enter</kbd><span>new line</span></li>
						<li><kbd class="kbd--icon" aria-label="Key button"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.8-9.8"/><path d="m16 7 3 3"/></svg></kbd><span>share a key to encrypt</span></li>
					</ul>
				</div>
			</section>
		</main>

		<footer class="dock">
			<div id="conn-stat" class="connstat" role="status">
				<span class="connstat__blink" aria-hidden="true"></span>
				<span class="connstat__text">Connecting...</span>
			</div>
			<form id="msgform" class="composer" autocomplete="off">
				<label class="sr-only" for="msgbox">Message</label>
				<div class="composer__box">
					<span class="composer__lock" id="composer-lock" hidden title="Messages will be encrypted">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
					</span>
					<textarea id="msgbox" class="composer__input" rows="1" placeholder="Type a message..." enterkeyhint="send"></textarea>
				</div>
				<button type="submit" class="btn btn--pink composer__send" title="Send (Enter)">
					<span class="composer__send-label">Send</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M3 11 21 3l-8 18-2-8-8-2z"/></svg>
				</button>
			</form>
		</footer>
	</div>

	<dialog id="encKeyDia" class="dialog" aria-labelledby="enc-title">
		<form method="dialog" class="card dialog__card">
			<div class="card__bar card__bar--yellow">
				<span class="card__bar-title" id="enc-title">Encryption key</span>
				<button type="button" class="dialog__x" id="enc-close" title="Close" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="square" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
				</button>
			</div>
			<div class="card__body">
				<p id="message" class="alert alert--inline" role="alert" hidden></p>
				<p class="dialog__text">Messages are encrypted in your browser before they leave. Everyone in the room needs the <b>same key</b>. Leave it empty to send plain text.</p>
				<div class="field">
					<label class="field__label" for="enckey">Key</label>
					<div class="input-prefix">
						<input id="enckey" class="input" type="password" placeholder="Shared secret" autocomplete="off" spellcheck="false" autofocus>
						<button type="button" class="input-prefix__btn" id="enckey-toggle" aria-label="Show key" title="Show key">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
						</button>
					</div>
				</div>
				<div class="dialog__actions">
					<button type="button" class="btn btn--white" id="enc-cancel" value="cancel">Cancel</button>
					<button class="btn btn--yellow" id="confirmBtn" value="confirm" formmethod="dialog">Confirm</button>
				</div>
			</div>
		</form>
	</dialog>

	<script>
		window.chatdata = {
			room_id: {{ .RoomID }},
			user_id: {{ .UserID }},
			username: {{ .Username }},
		}
	</script>
	<script src="/static/wasm_exec.js"></script>
	<script src="/static/index.js"></script>
</body>
</html>
{{ end }}
