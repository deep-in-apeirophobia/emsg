{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>#{{ .RoomID }} // emsg</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<link rel="stylesheet" href="/static/terminal.css">
	</head>
	<body class="crt" data-conn="down" data-enc="off">
		<div class="term">
			<header class="statusbar" aria-label="Status">
				<span class="tag">emsg</span>
				<span class="room" title="Room">#{{ .RoomID }}</span>
				<span class="who" title="You are logged in as"><span class="who-label sr-only">user </span><span data-uname>{{ .Username }}</span></span>
				<span class="spacer"></span>
				<button id="enc-btn" class="tbtn" type="button" command="show-modal" commandfor="encKeyDia" title="Set encryption key" aria-haspopup="dialog">
					<svg class="enc-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><rect x="4" y="11" width="16" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span class="br">[</span>enc: <span class="enc-state" id="enc-state">off</span><span class="br">]</span>
				</button>
				<span class="conn" role="status" aria-live="polite">
					<span id="conn-ok"><span class="br">[</span>connected<span class="br">]</span></span>
					<span id="conn-stat"><span class="led" aria-hidden="true"></span>Connecting...</span>
				</span>
			</header>

			<main id="messages" aria-live="polite" aria-label="Messages in #{{ .RoomID }}">
				<section class="motd" aria-label="Welcome">
<pre aria-hidden="true">███████╗███╗   ███╗███████╗ ██████╗
██╔════╝████╗ ████║██╔════╝██╔════╝
█████╗  ██╔████╔██║███████╗██║  ███╗
██╔══╝  ██║╚██╔╝██║╚════██║██║   ██║
███████╗██║ ╚═╝ ██║███████║╚██████╔╝
╚══════╝╚═╝     ╚═╝╚══════╝ ╚═════╝</pre>
					<p><span class="bang">-!-</span> Welcome to <span class="hi">#{{ .RoomID }}</span>, <span class="amber" data-uname>{{ .Username }}</span>.</p>
					<p><span class="bang">-!-</span> Messages are relayed live to everyone in this room; nothing is stored.</p>
					<p><span class="bang">-!-</span> Set a shared <span class="hi">[enc]</span> key to end-to-end encrypt what you send.</p>
				</section>
			</main>

			<footer class="prompt-area">
				<div class="infoline" aria-hidden="true">
					<span>[<b id="clock">--:--</b>]</span>
					<span>[<b data-uname>{{ .Username }}</b>]</span>
					<span>[<b>#{{ .RoomID }}</b>]</span>
					<span class="kb">[<b>Enter</b> send &middot; <b>Ctrl+Enter</b> newline]</span>
				</div>
				<form id="msgform" autocomplete="off">
					<label for="msgbox" class="ps1"><span class="u" data-uname>{{ .Username }}</span><span class="at">@</span><span class="h">{{ .RoomID }}</span> <span class="d">$</span></label>
					<div class="input-wrap">
						<textarea id="msgbox" rows="1" placeholder="type a message" spellcheck="false" aria-label="Message"></textarea>
						<span class="cursor" aria-hidden="true"></span>
					</div>
					<button type="submit" class="tbtn send" title="Send (Enter)">[send]</button>
				</form>
			</footer>
		</div>

		<dialog id="encKeyDia" aria-labelledby="enc-title">
			<form class="ncbox" method="dialog">
				<h2 class="nc-title" id="enc-title">Encryption key</h2>
				<p class="nc-desc">Everyone in the room must use the same key. Leave empty to send in plain text.</p>
				<p id="message" role="alert"></p>
				<label for="enckey" class="nc-field">Key:</label>
				<input id="enckey" type="password" autocomplete="off" spellcheck="false" placeholder="shared secret">
				<p class="nc-help">Keys never leave this device.</p>
				<div class="nc-actions">
					<button class="nc-btn" id="confirmBtn" value="confirm" formmethod="dialog"><span class="k">O</span>K</button>
					<button class="nc-btn" value="cancel" formmethod="dialog" formnovalidate><span class="k">C</span>ancel</button>
				</div>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
