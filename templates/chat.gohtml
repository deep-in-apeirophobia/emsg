{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>#{{ .RoomID }} &middot; EMSG VT220</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#0a0704">
		<link rel="stylesheet" href="/static/terminal-amber.css">
	</head>
	<body class="chat" data-conn="connecting" data-enc="off">
		<div class="vt">
			<div class="bezel">
				<div class="screen">
					<div class="scr">
						<header class="topline">
							<span class="dw" style="--n:4"><span>EMSG</span></span>
							<span class="room">CH <b>#{{ .RoomID }}</b></span>
							<button id="enc-btn" class="key" type="button" command="show-modal" commandfor="encKeyDia" title="Set-Up A: encryption key (F3)" aria-haspopup="dialog"><kbd>F3</kbd>SET-UP</button>
						</header>

						<section class="panel log" aria-labelledby="log-title">
							<h1 class="panel-title" id="log-title">#{{ .RoomID }}</h1>
							<p class="panel-note" aria-hidden="true">LIVE &middot; NOT STORED</p>
							<main id="messages" aria-live="polite" aria-label="Messages in #{{ .RoomID }}">
								<section class="motd" aria-label="Welcome">
									<p class="title">EMSG RELAY TERMINAL &middot; CHANNEL #{{ .RoomID }}</p>
									<p class="row"><span>OPERATOR</span><span class="lead"></span><span class="bright" data-uname>{{ .Username }}</span></p>
									<p class="row"><span>STORAGE</span><span class="lead"></span><span>NONE &mdash; LIVE RELAY ONLY</span></p>
									<p class="row"><span>ENCRYPTION</span><span class="lead"></span><span>SET-UP A &nbsp;[F3]</span></p>
									<p class="row keys"><span>KEYS</span><span class="lead"></span><span>RETURN SEND &middot; CTRL+RETURN NEW LINE</span></p>
									<p class="ready">READY.</p>
								</section>
							</main>
						</section>

						<form id="msgform" class="panel composer" autocomplete="off">
							<p class="panel-title" aria-hidden="true">TRANSMIT</p>
							<p class="panel-note offline" aria-hidden="true"><span class="when-down">&#9618; OFF LINE &middot; RETRYING &#9618;</span><span class="when-connecting">CONNECTING&hellip;</span></p>
							<p class="panel-note bottom keys-note" aria-hidden="true">RETURN=SEND &nbsp;CTRL+RETURN=NEW LINE</p>
							<div class="cmd">
								<label for="msgbox" class="ps"><span data-uname>{{ .Username }}</span>&gt;</label>
								<div class="input-wrap">
									<textarea id="msgbox" rows="1" spellcheck="false" aria-label="Message"></textarea>
									<div class="mirror" id="msgmirror" aria-hidden="true"></div>
								</div>
								<button type="submit" class="key send" title="Send (Return)"><span class="lbl">SEND</span> &#8629;</button>
							</div>
						</form>

						<footer class="statusline">
							<span class="st-ver" aria-hidden="true">EMSG V1.0</span>
							<span class="st-room" aria-hidden="true">#{{ .RoomID }}</span>
							<span class="st-user" aria-hidden="true" data-uname>{{ .Username }}</span>
							<span class="grow"></span>
							<span class="st-enc">ENC:<span id="enc-state">OFF</span></span>
							<span class="st-clock" id="clock" aria-hidden="true">--:--</span>
							<span class="st-state" id="conn-stat" role="status" aria-live="polite">CONNECTING</span>
						</footer>
					</div>
				</div>
			</div>
			<div class="case-foot" aria-hidden="true">
				<span class="badge"><i>emsg</i><span class="model">VIDEO TERMINAL</span></span>
				<span class="grille"></span>
				<span class="led conn">ON LINE</span>
				<span class="led on">POWER</span>
			</div>
		</div>

		<dialog id="encKeyDia" aria-labelledby="enc-title">
			<form method="dialog">
				<h2 class="su-head" id="enc-title"><span>SET-UP A: ENCRYPTION KEY</span><span aria-hidden="true">VT220</span></h2>
				<p class="su-dir" aria-hidden="true"><span>DISPLAY</span><span>GENERAL</span><span>COMM</span><span class="on">ENC KEY</span></p>
				<div class="su-body">
					<p>Shared secret for <span class="bright">#{{ .RoomID }}</span>. Every station on the channel must use the identical key. Leave blank to transmit in clear text.</p>
					<p id="message" role="alert"></p>
					<div class="field">
						<label for="enckey">Key</label>
						<span class="input"><input id="enckey" type="password" autocomplete="off" spellcheck="false" placeholder="shared secret"></span>
					</div>
					<p class="help">KEY IS HELD IN TERMINAL MEMORY ONLY. NEVER TRANSMITTED.</p>
				</div>
				<div class="su-actions">
					<button class="key" id="confirmBtn" value="confirm" formmethod="dialog"><kbd>RETURN</kbd>DONE</button>
					<button class="key" value="cancel" formmethod="dialog" formnovalidate><kbd>ESC</kbd>CANCEL</button>
					<span class="hint" aria-hidden="true">TO EXIT PRESS SET-UP</span>
				</div>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
