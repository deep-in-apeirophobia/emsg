{{ define "chat" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="color-scheme" content="light dark">
	<title>{{ .RoomID }} &middot; The emsg Dispatch</title>
	<link rel="stylesheet" href="/static/editorial.css">
</head>
<body class="page-chat">
	<header class="masthead">
		<div class="column masthead-inner">
			<div class="masthead-top">
				<a class="masthead-title" href="/" title="Back to the cover">The emsg <em>Dispatch</em></a>
				<button type="button" class="btn-key" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Encryption key">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.8-9.8"/><path d="m17 6 3 3"/><path d="m14.5 8.5 2 2"/></svg>
					<span class="btn-key-text" id="key-state">Cipher: off</span>
				</button>
			</div>
			<div class="dateline">
				<span><span class="label">Room</span> <strong class="room-name">{{ .RoomID }}</strong></span>
				<span class="sep" aria-hidden="true">&middot;</span>
				<span><span class="label">Correspondent</span> <span class="me-name" data-entities>{{ .Username }}</span></span>
				<span class="sep hide-sm" aria-hidden="true">&middot;</span>
				<span class="hide-sm" id="dateline-date"></span>
			</div>
		</div>
	</header>

	<main id="messages" class="transcript" aria-live="polite" aria-label="Messages">
		<div class="column transcript-inner" id="transcript">
			<section class="welcome">
				<p class="welcome-orn" aria-hidden="true">❦</p>
				<p class="label">Front page</p>
				<h1 class="welcome-title">Welcome to <em>{{ .RoomID }}</em></h1>
				<p class="welcome-deck">Letters appear below as they arrive. Share the room name with others on the network to bring them into the conversation.</p>
			</section>
		</div>
	</main>

	<footer class="composer">
		<div class="column">
			<div id="conn-stat" class="conn-stat" role="status">
				<span class="label">Stop press</span>
				<span class="conn-text">Connecting...</span>
			</div>
			<form id="msgform" class="pad" onsubmit="handleSubmit(event)" autocomplete="off">
				<label for="msgbox" class="visually-hidden">Message</label>
				<textarea
					id="msgbox"
					rows="1"
					placeholder="Write to the room&hellip;"
					onkeydown="handleKeyPressEvent(event)"></textarea>
				<div class="pad-foot">
					<p class="pad-hint"><kbd>Enter</kbd> to send &middot; <kbd>Ctrl</kbd>+<kbd>Enter</kbd> for a new line</p>
					<button type="submit" class="btn-send">Send <span aria-hidden="true">&crarr;</span></button>
				</div>
			</form>
		</div>
	</footer>

	<dialog id="encKeyDia" class="card" aria-labelledby="enc-title">
		<form method="dialog" class="card-form">
			<p class="label">Private correspondence</p>
			<h2 id="enc-title" class="card-title">Encryption key</h2>
			<hr class="rule">
			<p id="message" class="card-message"></p>
			<div class="field">
				<label for="enckey" class="label">Shared key</label>
				<input id="enckey" type="password" autocomplete="off" placeholder="Enter the room&rsquo;s key">
				<p class="field-hint">Leave empty to write in plain text.</p>
			</div>
			<div class="card-actions">
				<button value="cancel" formmethod="dialog" class="btn btn-quiet">Cancel</button>
				<button id="confirmBtn" formmethod="dialog" value="confirm" class="btn btn-ink">Confirm</button>
			</div>
		</form>
	</dialog>

	<script>
		window.chatdata = {
			room_id: {{ .RoomID }},
			user_id: {{ .UserID }},
			username: {{ .Username }},
		}
	</script>
	<script src="/static/wasm_exec.js"></script>
	<script src="/static/index.js"></script>
</body>
</html>
{{ end }}
