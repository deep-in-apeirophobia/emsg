{{ define "chat" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
	<meta name="theme-color" content="#05060f">
	<title>#{{ .RoomID }} · emsg</title>
	<link rel="stylesheet" href="/static/glass.css">
</head>
<body class="chat is-offline">
	<div class="aurora" aria-hidden="true"><div class="aurora__veil"></div></div>

	<div class="app">
		<header class="topbar glass">
			<a class="topbar__home" href="/" title="Back to start" aria-label="Back to start">
				<span class="logo logo--sm">{{ template "logo_svg" }}</span>
			</a>
			<div class="room">
				<h1 class="room__name"><span class="room__hash" aria-hidden="true">#</span>{{ .RoomID }}</h1>
				<span class="room__status"><span class="dot" aria-hidden="true"></span><span id="status-text">Connecting…</span></span>
			</div>
			<div class="topbar__spacer"></div>
			<button type="button" class="icon-btn key-btn" command="show-modal" commandfor="encKeyDia" title="Encryption key" aria-label="Encryption key">
				<svg class="icon-unlocked" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.4 2.7a2.5 2.5 0 0 1 3.4 0l5.5 5.5a2.5 2.5 0 0 1 0 3.4l-3.7 3.7a2.5 2.5 0 0 1-3.4 0L8.7 9.8a2.5 2.5 0 0 1 0-3.4z"/><path d="m14 7 3 3"/><path d="m9.4 10.6-6.814 6.814A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814"/></svg>
				<svg class="icon-locked" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 15v2"/></svg>
			</button>
			<div class="me">
				<div class="me__name">
					<strong id="me-name">{{ .Username }}</strong>
					<span>{{ slice (printf "%s·····" .UserID) 0 5 }}</span>
				</div>
				<span class="avatar" id="me-avatar" title="{{ .Username }}" aria-hidden="true">{{ slice (printf "%s?" .Username) 0 1 }}</span>
			</div>
		</header>

		<main id="messages" class="messages" aria-live="polite" aria-label="Messages">
			<section class="welcome glass">
				<span class="logo">{{ template "logo_svg" }}</span>
				<h2>Welcome to <span>#{{ .RoomID }}</span></h2>
				<p>Everyone who joins this room on the network will see your messages. New messages appear here as they arrive.</p>
				<div class="welcome__hints">
					<span class="chip"><kbd>Enter</kbd> send</span>
					<span class="chip"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> new line</span>
					<span class="chip">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
						Key icon to encrypt
					</span>
				</div>
			</section>
		</main>

		<div class="dock">
			<div id="conn-stat" class="conn-stat" role="status">Connecting...</div>
			<form id="msgform" class="composer glass" autocomplete="off">
				<label for="msgbox" class="sr-only">Message</label>
				<textarea id="msgbox" rows="1" placeholder="Message #{{ .RoomID }}" enterkeyhint="send"></textarea>
				<button type="submit" class="send-btn" title="Send (Enter)" aria-label="Send message">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2.5 10.6 13.4"/><path d="M21.5 2.5 14.6 21.3a.6.6 0 0 1-1.1 0l-2.9-7.9-7.9-2.9a.6.6 0 0 1 0-1.1Z" fill="currentColor" fill-opacity="0.18"/></svg>
				</button>
			</form>
			<p class="composer__hint">
				<span class="enc-off"><kbd>Enter</kbd> to send · <kbd>Ctrl</kbd>+<kbd>Enter</kbd> for a new line</span>
				<span class="enc-on">End-to-end encrypted with your shared key · <kbd>Enter</kbd> to send</span>
			</p>
		</div>
	</div>

	<dialog id="encKeyDia" class="dialog" aria-labelledby="enc-title">
		<form method="dialog">
			<div class="dialog__head">
				<span class="dialog__icon" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 15v2"/></svg>
				</span>
				<div>
					<h3 id="enc-title">Encryption key</h3>
					<p class="dialog__desc">Messages are encrypted in your browser. Everyone in the room needs the same key. Leave empty to send plain text.</p>
				</div>
			</div>
			<p id="message" class="dialog__error" role="alert"></p>
			<div class="field">
				<label class="field__label" for="enckey">Shared key</label>
				<div class="field__control">
					<svg class="field__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/></svg>
					<input id="enckey" class="input" type="password" placeholder="Enter encryption key" autocomplete="off" autofocus>
				</div>
			</div>
			<div class="dialog__actions">
				<!-- confirm comes first in the DOM so Enter in the key field confirms;
				     the row is reversed visually -->
				<button class="btn btn--primary" id="confirmBtn" value="confirm">Save key</button>
				<button class="btn btn--ghost" value="cancel" formnovalidate>Cancel</button>
			</div>
		</form>
	</dialog>

	<script>
		window.chatdata = {
			room_id: {{ .RoomID }},
			user_id: {{ .UserID }},
			username: {{ .Username }},
		}
	</script>
	<script src="/static/wasm_exec.js"></script>
	<script src="/static/index.js"></script>
</body>
</html>
{{ end }}
