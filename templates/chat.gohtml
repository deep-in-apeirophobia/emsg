{{ define "chat" }}
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>EMSG RELAY LOG · {{ .RoomID }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="light dark">
		<link rel="stylesheet" href="/static/terminal-teletype.css">
	</head>
	<body class="tty" data-conn="down" data-enc="off">
		<a class="skip" href="#msgbox">Skip to message input</a>

		<main id="messages" class="feed" aria-label="Printout for room {{ .RoomID }}">
			<div id="paper" class="paper">
				<div class="feed-gap" aria-hidden="true"></div>
				<div id="log" class="log" aria-live="polite">
					<header class="hdr" aria-label="Log header">
						<span>EMSG RELAY LOG</span>
						<span>ROOM: <b>{{ .RoomID }}</b></span>
						<span>OPERATOR: <b data-uname>{{ .Username }}</b></span>
						<span>PAGE 001</span>
					</header>
					<div class="rule rule-eq" aria-hidden="true"></div>
					<section class="motd" aria-label="Welcome">
<pre class="banner" aria-hidden="true">EEEEEEE  M     M   SSSSS    GGGGG
E        MM   MM  S        G
EEEEE    M M M M   SSSSS   G  GGG
E        M  M  M        S  G    G
EEEEEEE  M     M   SSSSS    GGGGG</pre>
						<p class="line sys note"><span class="mk"></span><span class="ts">**</span><span class="text">SESSION OPENED <span id="opened">--</span> ON ROOM <b>{{ .RoomID }}</b> FOR OPERATOR <b data-uname>{{ .Username }}</b>.</span></p>
						<p class="line sys note"><span class="mk"></span><span class="ts">**</span><span class="text">MESSAGES ARE RELAYED LIVE TO EVERY OPERATOR IN THIS ROOM. NOTHING IS STORED.</span></p>
						<p class="line sys note"><span class="mk"></span><span class="ts">**</span><span class="text">LOAD A SHARED <b class="red">KEY CARD</b> TO ENCIPHER WHAT YOU SEND. YOUR OWN LINES PRINT OVERSTRUCK, MARKED <b>*</b>.</span></p>
					</section>
					<div class="rule rule-dash" aria-hidden="true"></div>
				</div>
			</div>
		</main>

		<form id="msgform" class="carriage" autocomplete="off">
			<div class="typeline-wrap">
				<div class="typeline paper-bg">
					<p class="ready-line">
						<span class="rd rd-ok">READY.</span><span class="rd rd-bad">NOT READY. CARRIER LOST</span><span class="rd-enc">KEY LOADED: TRAFFIC ENCIPHERED</span>
						<span class="kb"><kbd>ENTER</kbd> SEND · <kbd>CTRL+ENTER</kbd> NEW LINE</span>
					</p>
					<div class="line self input-line">
						<span class="mk" aria-hidden="true">&gt;</span>
						<span class="ts" id="clock" aria-hidden="true">----</span>
						<label class="tag" for="msgbox"><span class="sr-only">Message from </span><span data-uname>{{ .Username }}</span></label>
						<div class="input-wrap">
							<textarea id="msgbox" rows="1" placeholder=" " spellcheck="false" aria-label="Message" enterkeyhint="send"></textarea>
							<span class="cursor" aria-hidden="true"></span>
						</div>
					</div>
				</div>
			</div>
			<div class="platen" aria-hidden="true"></div>
			<div class="console">
				<div class="lamp-group">
					<span class="lamp" aria-hidden="true"></span>
					<span id="conn-stat" role="status" aria-live="polite">DIALING…</span>
				</div>
				<div class="meta" aria-label="Session">
					<span class="meta-room">ROOM <b>{{ .RoomID }}</b></span>
					<span class="meta-page">PG <b id="pageno">001</b></span>
				</div>
				<div class="keys">
					<button id="enc-btn" class="keycap key-enc" type="button" command="show-modal" commandfor="encKeyDia" aria-haspopup="dialog" title="Load encryption key card">
						<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><rect x="4" y="11" width="16" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
						<span>KEY<span class="enc-sep">:</span> <span id="enc-state">NONE</span></span>
					</button>
					<button type="submit" class="keycap key-send" title="Send (Enter)">SEND <span aria-hidden="true">&#9166;</span></button>
				</div>
			</div>
		</form>

		<dialog id="encKeyDia" aria-labelledby="enc-title">
			<form class="card" method="dialog">
				<div class="card-field" id="card-field" aria-hidden="true"></div>
				<div class="card-body">
					<div class="card-head">
						<h2 id="enc-title">KEY CARD</h2>
						<span class="card-form">FORM KC-80 · ENCIPHERMENT</span>
					</div>
					<p class="card-desc">Every operator in the room must load the same key. Leave blank to transmit in plain text.</p>
					<p id="message" role="alert"></p>
					<label for="enckey" class="card-label">KEY</label>
					<input id="enckey" type="password" autocomplete="off" spellcheck="false" placeholder="shared secret">
					<p class="card-help">Keys stay on this terminal and are never transmitted.</p>
					<div class="card-actions">
						<button class="card-btn" value="cancel" formmethod="dialog" formnovalidate>CANCEL</button>
						<button class="card-btn primary" id="confirmBtn" value="confirm" formmethod="dialog">LOAD KEY</button>
					</div>
				</div>
			</form>
		</dialog>

		<script>
			window.chatdata = {
				room_id: {{ .RoomID }},
				user_id: {{ .UserID }},
				username: {{ .Username }},
			}
		</script>
		<script src="/static/wasm_exec.js"></script>
		<script src="/static/index.js"></script>
	</body>
	</html>
{{ end }}
