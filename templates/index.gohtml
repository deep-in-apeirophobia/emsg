{{ define "home_logged_in" }}
	<div class="whoami">
		<span class="whoami__label">Signed in as</span>
		<span class="whoami__name" data-unescape>{{ .Username }}</span>
		{{ if ge (len .UserID) 5 }}<code class="whoami__id" title="Session tag">#{{ slice .UserID 0 5 }}</code>{{ end }}
	</div>
{{ end }}
{{ define "home_login" }}
	<div class="field">
		<label class="field__label" for="username">Your name</label>
		<input class="input" id="username" name="username" autocomplete="nickname"
			autocapitalize="off" spellcheck="false" maxlength="64" placeholder="e.g. alice" required>
	</div>
{{ end }}
{{ define "home" }}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="color-scheme" content="light">
	<title>EMSG — Emergency Messenger</title>
	<link rel="stylesheet" href="/static/brutalist.css">
</head>
<body class="page-home">
	<main class="home">
		<section class="poster" aria-labelledby="poster-title">
			<p class="sticker sticker--pink poster__kicker">Emergency LAN messenger</p>
			<h1 class="poster__title" id="poster-title" aria-label="EMSG">
				<span class="tile tile--yellow" aria-hidden="true">E</span><span class="tile tile--pink" aria-hidden="true">M</span><span class="tile tile--cyan" aria-hidden="true">S</span><span class="tile tile--violet" aria-hidden="true">G</span>
			</h1>
			<p class="poster__sub">Talk when the internet won't. Pick a name, pick a room, start typing.</p>
			<ul class="poster__facts">
				<li class="chip chip--cyan">No accounts</li>
				<li class="chip chip--yellow">Local network</li>
				<li class="chip chip--violet">Optional AES key</li>
			</ul>
		</section>

		<form class="card login" method="post" action="/">
			<div class="card__bar card__bar--yellow">
				<span class="card__bar-title">{{ if .IsLoggedIn }}Welcome back{{ else }}Join a room{{ end }}</span>
				<span class="card__bar-dots" aria-hidden="true"><i></i><i></i><i></i></span>
			</div>
			<div class="card__body">
				{{ if .IsLoggedIn }}
					{{ template "home_logged_in" . }}
				{{ else }}
					{{ template "home_login" }}
				{{ end }}
				<div class="field">
					<label class="field__label" for="roomid">Room</label>
					<div class="input-prefix">
						<span class="input-prefix__mark" aria-hidden="true">#</span>
						<input class="input" id="roomid" name="roomid" value="{{ .RoomID }}"
							autocapitalize="off" spellcheck="false" placeholder="e.g. lobby" required>
					</div>
					<p class="field__hint">Everyone who types the same room name ends up together.</p>
				</div>

				{{ if .Error }}
				<div class="alert" role="alert">
					<svg class="alert__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 21h20L12 3z"/><path d="M12 10v5"/><path d="M12 18h.01"/></svg>
					<div>
						<strong class="alert__title">Couldn't get you in</strong>
						<p class="alert__text">{{ .ErrorMessage }}</p>
					</div>
				</div>
				{{ end }}

				<button type="submit" class="btn btn--pink btn--block btn--big">
					Enter room
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15"/><path d="m13 5 7 7-7 7"/></svg>
				</button>
			</div>
		</form>
	</main>
	<script>
		// Usernames arrive pre-escaped by the server; show them as typed.
		(function () {
			var map = { "&amp;": "&", "&lt;": "<", "&gt;": ">", "&#39;": "'", "&#34;": '"', "&quot;": '"' };
			document.querySelectorAll("[data-unescape]").forEach(function (node) {
				node.textContent = node.textContent.replace(/&(?:amp|lt|gt|quot|#39|#34);/g, function (m) { return map[m]; });
			});
		})();
	</script>
	<footer class="home-foot">
		<span>Runs on your LAN</span><span aria-hidden="true">✶</span><span>No internet needed</span>
	</footer>
</body>
</html>
{{ end }}
